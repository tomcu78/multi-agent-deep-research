# ==============================================================================
# Multi-Agent Deep Research & Synthesizer - Environment Configuration
# ==============================================================================

# LLM Providers (Configure at least one, or system runs in mock/simulation mode)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# LLM Selection
DEFAULT_LLM_PROVIDER=openai # Options: openai, anthropic, google, mock
DEFAULT_MODEL_NAME=gpt-4o-mini # Options: gpt-4o, gpt-4o-mini, claude-3-5-sonnet-20241022, gemini-1.5-pro, mock

# Search APIs
TAVILY_API_KEY=your_tavily_api_key_here # Optional, falls back to DuckDuckGo search

# Research Workflow Controls
MAX_RESEARCH_ITERATIONS=3
MAX_SUBTASKS=4
MAX_SEARCH_RESULTS_PER_QUERY=5
SCRAPE_TIMEOUT_SECONDS=10
CRITIC_MIN_SCORE=80.0
ENABLE_REFLECTION_LOOP=true
